@echo off
@rem Copyright 2024 NXP
@rem SPDX-License-Identifier: BSD-3-Clause
@rem This is sample of the build hooks, that are executed from the build script. This allows to customize the operation executed from the build script
@rem Use parameter: "<step>" to identify which hook should be executed
@rem "<step>" is used as label call
call :%1 2>NUL
if errorlevel 2 goto error_state
if errorlevel 1 goto non_defined
exit /B 0
:non_defined
@echo parameter %1 is not supported
exit /B 2
:error_state
@echo step %1 failed
exit /B 2

:started
@rem hook executed before any other command is executed
@echo ### execution of build-hook: started ###
goto end
:pfr_generation_done
@rem hook executed after CFPA or/and CMPA page generation is done
@echo ### execution of build-hook: pfr_generation_done ###
goto end
:build_image_done
@rem hook executed after build of bootable image is done
@echo ### execution of build-hook: build_image_done ###
goto end
:build_sb_done
@rem hook executed after SB file generation is done
@echo ### execution of build-hook: build_sb_done ###
goto end
:finished
@rem hook executed after all steps of the script were executed
@echo ### execution of build-hook: finished ###
goto end
:end
@rem Reset error state at the end of the step execution, failed commands should be handled in step handling.
ver > NUL