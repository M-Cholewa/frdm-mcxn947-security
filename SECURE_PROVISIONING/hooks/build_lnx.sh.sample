#! /bin/bash
# Copyright 2024 NXP
# SPDX-License-Identifier: BSD-3-Clause
# This is sample of the build hooks, that are executed from the build script. This allows to customize the operation executed from the build script
# Use parameter: "<step>" to identify which hook should be executed
case "${1}" in
  started)
    # hook executed before any other command is executed
    echo "### execution of build-hook: started ###"
    ;;
  pfr_generation_done)
    # hook executed after CFPA or/and CMPA page generation is done
    echo "### execution of build-hook: pfr_generation_done ###"
    ;;
  build_image_done)
    # hook executed after build of bootable image is done
    echo "### execution of build-hook: build_image_done ###"
    ;;
  build_sb_done)
    # hook executed after SB file generation is done
    echo "### execution of build-hook: build_sb_done ###"
    ;;
  finished)
    # hook executed after all steps of the script were executed
    echo "### execution of build-hook: finished ###"
    ;;
  *)
    echo "parameter ${1} is not supported"
    exit 2
    ;;
esac